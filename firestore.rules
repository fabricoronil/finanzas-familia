rules_version = '2';

// Solo las cuentas de Google de esta lista pueden ver y cargar datos.
// Para sumar a alguien: agregá su email (en minúsculas) y volvé a publicar las reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function esDeLaFamilia() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'tu-email@gmail.com',
          'email-de-papa@gmail.com',
          'email-de-mama@gmail.com'
        ];
    }

    match /hogar/{documento=**} {
      allow read, write: if esDeLaFamilia();
    }
  }
}
