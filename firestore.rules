rules_version = '2';

// Acceso a los datos de la casa:
// - El dueño (coronilfabri@gmail.com) siempre puede entrar.
// - Cualquiera que abra el link de invitación y entre con Google queda
//   registrado en hogar/principal/accesos/{su email}. Para registrarse tiene
//   que presentar el código vigente del link (hogar/principal.codigo).
// - Nadie más puede leer ni escribir nada.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() {
      return request.auth.token.email.lower();
    }
    function conSesion() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function esDueno() {
      return conSesion() && email() == 'coronilfabri@gmail.com';
    }
    function hogar() {
      return /databases/$(database)/documents/hogar/principal;
    }
    function codigoVigente() {
      return exists(hogar()) ? get(hogar()).data.get('codigo', '') : '';
    }
    function esMiembro() {
      return esDueno()
        || (conSesion() && (
          exists(/databases/$(database)/documents/hogar/principal/accesos/$(email()))
          || (exists(hogar()) && email() in get(hogar()).data.get('miembros', []))
        ));
    }

    match /hogar/principal {
      allow read: if esMiembro();
      allow create: if esDueno();
      allow update: if esDueno()
        || (esMiembro() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['miembros', 'codigo']));
    }

    match /hogar/principal/accesos/{correo} {
      allow read: if esMiembro();
      allow create, update: if conSesion()
        && correo == email()
        && request.resource.data.email == email()
        && codigoVigente() != ''
        && request.resource.data.codigo == codigoVigente();
      allow delete: if esDueno();
    }

    match /hogar/principal/items/{item} {
      allow read, write: if esMiembro();
    }
  }
}
